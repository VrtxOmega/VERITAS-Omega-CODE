{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VERITAS Ω BuildClaim",
  "description": "JSON schema for the deterministic VERITAS Ω-CODE v2.0 BuildClaim.",
  "type": "object",
  "required": ["project", "version", "commit", "primitives", "boundaries", "evidence"],
  "properties": {
    "project": {
      "type": "string",
      "description": "Project identifier (e.g., 'VERITAS-Omega-CODE')"
    },
    "version": {
      "type": "string",
      "description": "Semantic versioning number"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Git Commit SHA1 Hash (40-character hex)"
    },
    "primitives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "domain"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "units": { "type": "string" },
          "domain": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["Interval", "EnumSet", "FiniteSet"] }
            }
          }
        }
      }
    },
    "boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "constraint"],
        "properties": {
          "name": { "type": "string" },
          "constraint": { "type": "object" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "variable", "value", "provenance"],
        "properties": {
          "id": { "type": "string" },
          "variable": { "type": "string" },
          "value": { "type": "object" },
          "timestamp": { "type": "string", "format": "date-time" },
          "method": { "type": "object" },
          "provenance": {
            "type": "object",
            "required": ["source_id", "tier"],
            "properties": {
              "source_id": { "type": "string" },
              "tier": { "type": "string", "enum": ["A", "B", "C", "D", "E"] },
              "acquisition": { "type": "string" }
            }
          }
        }
      }
    },
    "cost_bounds": {
      "type": "object",
      "properties": {
        "capital_usd": { "type": "number" },
        "compute_flops": { "type": "number" },
        "memory_bytes": { "type": "number" },
        "wall_clock_s": { "type": "number" }
      }
    }
  }
}
